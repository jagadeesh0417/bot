# --- Core ---
APP_NAME=CollegeAI
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-this-to-a-long-random-string
BASE_URL=https://your-app.example.com
PORT=3000
COLLEGE_NAME=CollegeAI Institute

# --- MongoDB (required) ---
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=college_ai

# --- Cloudinary (optional, image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=college_ai

# --- AI Provider: openai | gemini | none ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Bootstrap admin ---
ADMIN_NAME=College Admin
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@123456
# Required to create extra admins via POST /api/auth/register/admin
ADMIN_SECRET=change-this-too

# --- Security ---
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=20

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
